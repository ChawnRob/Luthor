# LUTHOR MCP tool credentials (leave empty until connectors are enabled)

# n8n automation
N8N_API_URL=
N8N_API_KEY=

# PenPot design
PENPOT_API_URL=
PENPOT_ACCESS_TOKEN=

# AppFlowy external memory
APPFLOWY_API_URL=
APPFLOWY_TOKEN=

# Plausible analytics
PLAUSIBLE_API_URL=https://plausible.io
PLAUSIBLE_SITE_ID=
PLAUSIBLE_TOKEN=

# Mistral orchestration (function calling)
MISTRAL_API_KEY=
LUTHOR_MCP_LLM_PROVIDER=mistral
LUTHOR_MCP_MODEL=mistral-small-latest
LUTHOR_MCP_ENABLED=true

# Whisper transcription
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
LUTHOR_MCP_WHISPER_ENABLED=true

# yt-dlp downloads
YTDLP_DOWNLOAD_DIR=./data/downloads
YTDLP_MAX_DOWNLOADS_PER_USER=10
LUTHOR_MCP_YTDLP_ENABLED=true

# Fooocus image generation
FOOOCUS_API_URL=http://localhost:8888
FOOOCUS_API_KEY=

# Cal.com scheduling
CALCOM_API_URL=http://localhost:3000
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
LUTHOR_MCP_CALCOM_ENABLED=false
LUTHOR_MCP_FOOOCUS_ENABLED=false
