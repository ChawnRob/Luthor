# Copy to .env.prod on your VPS: cp .env.prod.example .env.prod

# --- Domain & TLS (European VPS) ---
LUTHOR_DOMAIN=luthor.example.com
ACME_EMAIL=admin@example.com

# Dashboard UI: https://app.${LUTHOR_DOMAIN} — API CORS for browser requests
LUTHOR_CORS_ORIGINS=https://app.${LUTHOR_DOMAIN}
LUTHOR_EXPORT_TOKEN=change-me-export-token

# --- PostgreSQL ---
POSTGRES_USER=luthor
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=luthor

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- LUTHOR / Mistral (EU provider) ---
MISTRAL_API_KEY=
LUTHOR_MCP_LLM_PROVIDER=mistral
LUTHOR_MCP_MODEL=mistral-small-latest

# --- MCP connectors (internal Docker DNS) ---
LUTHOR_MCP_N8N_ENABLED=true
N8N_API_KEY=

LUTHOR_MCP_PLAUSIBLE_ENABLED=true
PLAUSIBLE_SITE_ID=luthor.example.com
PLAUSIBLE_TOKEN=
PLAUSIBLE_SECRET_KEY_BASE=change-me-plausible-secret

LUTHOR_MCP_FOOOCUS_ENABLED=true
FOOOCUS_API_KEY=

LUTHOR_MCP_CALCOM_ENABLED=true
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_NEXTAUTH_SECRET=change-me-calcom-nextauth
CALCOM_ENCRYPTION_KEY=change-me-calcom-encryption-32chars

LUTHOR_MCP_WHISPER_ENABLED=true
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu

LUTHOR_MCP_YTDLP_ENABLED=true
YTDLP_DOWNLOAD_DIR=/app/data/downloads
YTDLP_MAX_DOWNLOADS_PER_USER=20

# --- Optional external tools (PenPot, AppFlowy) ---
PENPOT_API_URL=
PENPOT_ACCESS_TOKEN=
APPFLOWY_API_URL=
APPFLOWY_TOKEN=
