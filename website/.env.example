# LUTHOR dashboard — copy to .env for local development
VITE_API_URL=http://localhost:8080

# Optional: embed Grafana (otherwise Prometheus charts from /metrics)
# VITE_GRAFANA_URL=https://grafana.luthor.example.com/d/luthor/luthor

# Token for GET /export/logs (must match LUTHOR_EXPORT_TOKEN on the API)
# VITE_EXPORT_TOKEN=change-me-export-token
